{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isnad-journey",
  "main": "./workers/app.ts",
  // Kept from the React Router scaffold; bump deliberately (docs/adr/0002).
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // SPEC §4/§17 sets "limits": { "cpu_ms": 5000 } on Workers Paid. The account is on
  // the Free plan for now, which rejects CPU limits (docs/adr/0015); restore the line
  // after upgrading.
  // Phase 0 bindings. MATN_INDEX (Vectorize), AI and the rate limiters are
  // added in the phase that first uses them (docs/adr/0008).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isnad-core",
      "database_id": "1d480790-5c76-430d-8a1f-df2ee33522c1",
      "migrations_dir": "migrations"
    },
    {
      "binding": "SEARCH_DB",
      "database_name": "isnad-search",
      "database_id": "6a02aa10-4616-432b-9a15-0fff6cfd28b1",
      "migrations_dir": "migrations-search"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "2c45150a0d8c4777a0956b797b7317f1" }],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "isnad-data" }],
  // Per-IP rate limits (SPEC §14): search 60/min, reports 5/min, other API calls 300/min.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "SITE_URL": "https://isnad-journey.chaditechno7.workers.dev",
    // Public Turnstile site key (the secret is set with `wrangler secret put TURNSTILE_SECRET`).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGKFPQxBkAElDdPP"
  },
  "env": {
    "preview": {
      "name": "isnad-journey-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "isnad-core-preview",
          "database_id": "65287f6c-afef-4a4b-8f1d-dd30c80f2b1d",
          "migrations_dir": "migrations"
        },
        {
          "binding": "SEARCH_DB",
          "database_name": "isnad-search-preview",
          "database_id": "994a81ae-ee3d-4dc2-9dd4-8dac02e6354d",
          "migrations_dir": "migrations-search"
        }
      ],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "babc6ffa31fd4c5a8885a2bb146cffef" }],
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "isnad-data-preview" }],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "REPORT_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
        "SITE_URL": "https://isnad-journey-preview.chaditechno7.workers.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGKFPQxBkAElDdPP"
      }
    }
  }
}
