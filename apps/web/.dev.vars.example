# Copy to .dev.vars for local development. Real secrets go in `wrangler secret put` only.
# Cloudflare's documented always-pass Turnstile TEST secret:
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
ACCESS_AUD=local-placeholder

# Local development only: production builds ignore this (import.meta.env.DEV).
DEV_ADMIN_EMAIL=admin@localhost
# Local only: the always-pass TEST site key overrides the real one from wrangler.jsonc.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
