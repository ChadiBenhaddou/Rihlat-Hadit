{
  "name": "@isnad/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "pnpm build && vite preview",
    "cf-typegen": "wrangler types && react-router typegen",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply SEARCH_DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview && wrangler d1 migrations apply SEARCH_DB --remote --env preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@isnad/graph": "workspace:*",
    "@isnad/shared": "workspace:*",
    "hono": "^4.13.19",
    "isbot": "^5.1.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
